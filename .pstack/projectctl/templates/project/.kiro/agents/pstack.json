      },
      {
        "capability": "subagent",
        "match": [
          "pstack-architect",
          "pstack-reviewer",
          "pstack-verifier"
        ],
        "effect": "allow"
      }
    ]
  },
  "toolsSettings": {
    "subagent": {
      "availableAgents": [
        "pstack-architect",
        "pstack-reviewer",
        "pstack-verifier"
      ],
      "trustedAgents": [
        "pstack-architect",
        "pstack-reviewer",
        "pstack-verifier"
