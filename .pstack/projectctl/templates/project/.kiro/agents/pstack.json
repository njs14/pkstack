      },
      {
        "capability": "fs_write",
        "match": [
          "./**"
        ],
        "effect": "ask"
      },
      {
        "capability": "shell",
        "match": [
          "rm -rf *",
          "rm -r*",
          "rm -R*",
          "rm -*r*",
          "rm -*R*",
          "sudo *",
          "git reset --hard*",
          "git * reset --hard*",
          "git checkout *",
          "git checkout -- *",
          "git * checkout *",
          "git restore *",
          "git * restore *",
          "git clean -*",
          "git * clean -*",
          "git branch -d *",
          "git branch -D *",
