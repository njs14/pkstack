#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
PROJECTCTL_ROOT="$SCRIPT_DIR/../projectctl"
cd "$PROJECT_ROOT"
if [ "${PYTHONPATH+x}" = x ]; then
  PK_STACK_CALLER_PYTHONPATH_SET=1
  PK_STACK_CALLER_PYTHONPATH=$PYTHONPATH
else
  PK_STACK_CALLER_PYTHONPATH_SET=0
  PK_STACK_CALLER_PYTHONPATH=
fi
export PK_STACK_CALLER_PYTHONPATH_SET PK_STACK_CALLER_PYTHONPATH
uv sync --quiet --locked --no-config --project "$PROJECTCTL_ROOT"
PYTHONPATH="$PROJECTCTL_ROOT/src"   exec "$PROJECTCTL_ROOT/.venv/bin/python" -B -X pycache_prefix=/dev/null     -m pk_stack "$@"
