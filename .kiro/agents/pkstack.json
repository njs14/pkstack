          "git switch -dqf*",
          "git switch * -dqf*",
          "git switch -qC*",
          "git switch * -qC*",
          "git * switch -qf*",
          "git * switch * -qf*",
          "git * switch -dqf*",
          "git * switch * -dqf*",
          "git * switch -qC*",
          "git * switch * -qC*",
          "git restore *",
          "git * restore *",
          "git clean -*",
          "git * clean -*",
          "git branch -d *",
          "git branch -D *",
          "git branch --delete *",
          "git * branch -d *",
          "git * branch -D *",
          "git * branch --delete *",
          "git push --force*",
          "git push -f*",
          "git push * --force*",
          "git push * -f*",
          "git push +*",
          "git push * +*",
          "git push --mirror*",
          "git push * --mirror*",
          "git * push --force*",
          "git * push -f*",
          "git * push * --force*",
          "git * push * -f*",
          "git * push +*",
          "git * push * +*",
          "git * push --mirror*",
          "git * push * --mirror*",
          "terraform apply*",
          "terraform destroy*",
          "tofu apply*",
          "tofu destroy*",
          "aws * delete-*",
          "aws * terminate-*",
