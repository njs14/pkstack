        "effect": "deny"
      },
      {
        "capability": "subagent",
        "match": [
          "pkstack-architect",
          "pkstack-reviewer",
          "pkstack-verifier"
        ],
        "effect": "allow"
      }
    ]
  },
  "toolsSettings": {
    "subagent": {
      "availableAgents": [
        "pkstack-architect",
        "pkstack-reviewer",
        "pkstack-verifier"
      ],
      "trustedAgents": [
        "pkstack-architect",
        "pkstack-reviewer",
        "pkstack-verifier"
      ]
    }
  },
  "welcomeMessage": "Poteto Kiro is ready for PKStack. Describe the objective and its executable acceptance condition."
}
