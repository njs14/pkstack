{
  "name": "pkstack",
  "description": "Poteto Kiro primary agent for PKStack implementation in the current Kiro agent session with deterministic projectctl verification.",
  "prompt": "Kiro owns execution and native planning. PKStack owns workflow semantics. projectctl owns project operability and executable verification. Route nontrivial feature and bug work through Kiro's native Spec, Quick Spec, or Bug Fix workflow; after its requirements or bug analysis, design, and tasks are ready, return to this agent in the same IDE or CLI conversation and bind the spec to a reviewed executable command or published feature verifier. Do not recreate Kiro's task graph or treat a task checkbox as proof. Start context at the narrow feature map and use canonical okn only for deeper architecture, decisions, concepts, or operations. Stay in the current Kiro agent session on the selected surface, preserve unrelated work, and never report completion without verifier evidence. Kiro IDE 1.x and Kiro CLI v3 are the primary surfaces. Kiro Crew is optional and may use ACP internally; do not make ACP the default PKStack path. On Kiro Web this profile is delegation-only; do not claim it is the primary agent or that IDE/CLI permissions apply. Route requested or scheduled PKStack upstream maintenance through /pkstack-maintain and its immutable feature goal.",
  "tools": [
    "read",
    "write",
    "shell",
    "subagent",
    "knowledge"
  ],
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/*/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git",
          "git *"
        ],
        "effect": "ask"
      },
      {
        "capability": "shell",
        "match": [
          ".pkstack/bin/projectctl",
          ".pkstack/bin/projectctl *"
        ],
        "effect": "ask"
      },
      {
        "capability": "fs_write",
        "match": [
          ".pkstack/**",
          ".kiro/agents/**",
          ".kiro/hooks/**",
          ".kiro/skills/archify/**",
          ".kiro/skills/architect/**",
          ".kiro/skills/arena/**",
          ".kiro/skills/automate-me/**",
          ".kiro/skills/blast-radius/**",
          ".kiro/skills/bro/**",
          ".kiro/skills/build-iterated-agentic-loop/**",
          ".kiro/skills/create-verification-skill/**",
          ".kiro/skills/design-control-loop/**",
          ".kiro/skills/figure-it-out/**",
          ".kiro/skills/how/**",
          ".kiro/skills/writing-for-agents/**",
          ".kiro/skills/interrogate/**",
          ".kiro/skills/pkstack-maintain/**",
          ".kiro/skills/maintain-verification-skill/**",
          ".kiro/skills/pkstack-model-council/**",
          ".kiro/skills/narrow-react-prop-types/**",
          ".kiro/skills/no-comments/**",
          ".kiro/skills/okf/**",
          ".kiro/skills/pkstack/**",
          ".kiro/skills/principle-boundary-discipline/**",
          ".kiro/skills/principle-build-the-lever/**",
          ".kiro/skills/principle-encode-lessons-in-structure/**",
          ".kiro/skills/principle-exhaust-the-design-space/**",
          ".kiro/skills/principle-experience-first/**",
          ".kiro/skills/principle-fix-root-causes/**",
          ".kiro/skills/principle-foundational-thinking/**",
          ".kiro/skills/principle-guard-the-context-window/**",
          ".kiro/skills/principle-laziness-protocol/**",
          ".kiro/skills/principle-make-operations-idempotent/**",
          ".kiro/skills/principle-migrate-callers-then-delete-legacy-apis/**",
          ".kiro/skills/principle-minimize-reader-load/**",
          ".kiro/skills/principle-model-the-domain/**",
          ".kiro/skills/principle-never-block-on-the-human/**",
          ".kiro/skills/principle-outcome-oriented-execution/**",
          ".kiro/skills/principle-prove-it-works/**",
          ".kiro/skills/principle-redesign-from-first-principles/**",
          ".kiro/skills/principle-separate-before-serializing-shared-state/**",
          ".kiro/skills/principle-sequence-verifiable-units/**",
          ".kiro/skills/principle-subtract-before-you-add/**",
          ".kiro/skills/principle-type-system-discipline/**",
          ".kiro/skills/pkstack-principles/**",
          ".kiro/skills/recall/**",
          ".kiro/skills/reflect/**",
          ".kiro/skills/show-me/**",
          ".kiro/skills/show-me-your-work/**",
          ".kiro/skills/swarm/**",
          ".kiro/skills/tdd/**",
          ".kiro/skills/teach/**",
          ".kiro/skills/technical-writing/**",
          ".kiro/skills/typescript-best-practices/**",
          ".kiro/skills/unslop/**",
          ".kiro/skills/pkstack-verified-goal/**",
          ".kiro/skills/why/**",
          ".kiro/steering/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "./**"
        ],
        "effect": "ask"
      },
      {
        "capability": "shell",
        "match": [
          "rm -rf *",
          "rm -r*",
          "rm -R*",
          "rm -*r*",
          "rm -*R*",
          "sudo *",
          "git reset --hard*",
          "git * reset --hard*",
          "git checkout *",
          "git checkout -- *",
          "git * checkout *",
          "git switch -f*",
          "git switch * -f*",
          "git switch --force*",
          "git switch * --force*",
          "git switch --discard-changes*",
          "git switch * --discard-changes*",
          "git switch -C*",
          "git switch * -C*",
          "git * switch -f*",
          "git * switch * -f*",
          "git * switch --force*",
          "git * switch * --force*",
