{
  "name": "pkstack-permission-fixture",
  "description": "Manual CI-only proof that Kiro 2.21 honors the exact production pkstack-maintainer filesystem permission rules.",
  "prompt": "This is a sterile permission fixture, not project maintenance. Execute exactly and only the ordered filesystem operations enumerated in the current user prompt. Do not infer, retry, or add operations. Do not access the network, shell, MCP, Powers, slash commands, git, or any path not explicitly named by the user prompt. Emit no assistant prose before or after tool use. End immediately after the final requested operation, including when that operation is denied.",
  "tools": [
    "read",
    "grep",
    "write"
  ],
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [
    "file://fixture-input.txt"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      },
      {
        "capability": "grep",
        "match": [
          "./**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".pkstack-maintenance/proposal.json",
          "powers/pkstack/README.md",
          "powers/pkstack/docs/okf-skills-parity.json",
          "powers/pkstack/docs/humanlayer-show-me-bundle-manifest.json",
          "powers/pkstack/docs/humanlayer-skills-source-parity.json",
          "powers/pkstack/docs/humanlayer-build-iterated-agentic-loop-bundle-manifest.json",
          "powers/pkstack/docs/humanlayer-design-control-loop-bundle-manifest.json",
          "powers/pkstack/docs/mattpocock-writing-for-agents-bundle-manifest.json",
          "powers/pkstack/docs/mattpocock-writing-for-agents-provenance.md",
          "powers/pkstack/docs/mattpocock-writing-for-agents-source-parity.json",
          "powers/pkstack/docs/mattpocock-grilling-source-parity.json",
          "powers/pkstack/docs/mattpocock-grilling-bundle-manifest.json",
          "powers/pkstack/docs/mattpocock-grill-me-source-parity.json",
          "powers/pkstack/docs/mattpocock-grill-me-bundle-manifest.json",
          "powers/pkstack/docs/mattpocock-domain-modeling-source-parity.json",
          "powers/pkstack/docs/mattpocock-domain-modeling-bundle-manifest.json",
          "powers/pkstack/docs/mattpocock-grill-with-docs-source-parity.json",
          "powers/pkstack/docs/mattpocock-grill-with-docs-bundle-manifest.json",
          "powers/pkstack/docs/humanlayer-narrow-react-prop-types-bundle-manifest.json",
          "powers/pkstack/docs/tt-a1i-archify-bundle-manifest.json",
          "powers/pkstack/docs/tt-a1i-archify-source-parity.json",
          "powers/pkstack/docs/upstream-skill-parity.json",
          "powers/pkstack/dev.kiro/**/*.md",
          "powers/pkstack/docs/**/*.md",
          "powers/pkstack/skills/**/*.md",
          "powers/pkstack/templates/project/**/*.json",
          "powers/pkstack/docs/astral-python-source-parity.json",
          "powers/pkstack/docs/astral-uv-bundle-manifest.json",
          "powers/pkstack/docs/astral-ruff-bundle-manifest.json",
          "powers/pkstack/docs/astral-ty-bundle-manifest.json",
          "Wiki/knowledge/**/*.md",
          "maintenance/knowledge-coverage.json",
          "powers/pkstack/docs/google-open-knowledge-format-source-parity.json"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".github/**",
          ".git/**",
          ".kiro/**",
          ".pkstack/**",
          ".pkstack-ci/**",
          ".claude/**",
          ".codex/**",
          ".cursor/**",
          ".gemini/**",
          "**/.claude/**",
          "**/.codex/**",
          "**/.cursor/**",
          "**/.gemini/**",
          "**/AGENTS.md",
          "**/CLAUDE.local.md",
          "**/CLAUDE.md",
          "**/GEMINI.md",
          "AGENTS.md",
          "CLAUDE.local.md",
          "CLAUDE.md",
          "GEMINI.md",
          "powers/pkstack/docs/validation-report.md",
          "powers/pkstack/examples/**",
          "powers/pkstack/pyproject.toml",
          "powers/pkstack/reviews/**",
          "powers/pkstack/src/pkstack/**",
          "powers/pkstack/tests/**",
          "powers/pkstack/uv.lock",
          "projectctl",
          "reviews/**",
          "Wiki/index.md",
          "Wiki/features/**",
          "Wiki/work/**",
          "Wiki/knowledge/pkstack/corpus-migration.md",
          "Wiki/knowledge/pkstack/corpus-inventory.json",
          "maintenance/upstreams.json",
          "maintenance/upstream-reviews.json",
          "maintenance/upstream-feedback.json"
        ],
        "effect": "deny"
      }
    ]
  },
  "toolsSettings": {},
  "welcomeMessage": "Exact production PKStack filesystem permission fixture loaded."
}
